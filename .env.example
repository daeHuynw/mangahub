# Copy to .env (never commit .env) or export these before running.
# Backend (cmd/backend)
HTTP_ADDR=:8080
TCP_ADDR=:9090
UDP_ADDR=:9091
CATALOG_ADDR=localhost:9092
BACKEND_DB=backend.db
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-admin-key
# Leave empty to disable the Redis cache (F07, optional)
REDIS_ADDR=
CATALOG_TIMEOUT=2s
CACHE_TTL=30s

# Catalog service (cmd/catalog)
CATALOG_LISTEN=:9092
CATALOG_DB=catalog.db

# TUI (cmd/tui)
MANGAHUB_HTTP=http://localhost:8080
MANGAHUB_TCP=localhost:9090
MANGAHUB_UDP=localhost:9091
